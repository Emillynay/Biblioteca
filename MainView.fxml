<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="650.0" prefWidth="1000.0" stylesheets="@src/css/style.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.MainController">
   <left>
      <VBox prefHeight="200.0" prefWidth="200.0" spacing="10.0" styleClass="menu" BorderPane.alignment="CENTER">
