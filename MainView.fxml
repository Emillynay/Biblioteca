            <Button mnemonicParsing="false" onAction="#abrirLivros" prefHeight="45.0" prefWidth="180.0" text="📚 Livros" />
            <Button mnemonicParsing="false" onAction="#abrirUsuarios" prefHeight="45.0" prefWidth="180.0" text="👤 Usuários" />
            <Button mnemonicParsing="false" prefHeight="45.0" prefWidth="180.0" text="📖 Empréstimos" />
