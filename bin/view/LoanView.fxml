<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.LoanController"
            stylesheets="@style.css" >

    <top>

        <VBox spacing="15.0"
              alignment="CENTER">

            <padding>
                <Insets top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <Label text="GERENCIAR EMPRÉSTIMOS"
                   styleClass="book-title"/>

            <HBox spacing="15.0"
                  alignment="CENTER">

                <Label text="Usuário:"/>

                <ComboBox fx:id="userComboBox"
                          prefWidth="300.0"
                          promptText="Selecione o usuário"/>

                <Label text="Livro:"/>

                <ComboBox fx:id="bookComboBox"
                          prefWidth="300.0"
                          promptText="Selecione o livro"/>

            </HBox>

            <HBox spacing="10.0"
                  alignment="CENTER">

                <Button text="Realizar Empréstimo"
                        onAction="#handleSave"/>

                <Button text="Devolver Livro"
                        onAction="#handleReturn"/>

                <Button text="Remover Empréstimo"
                        onAction="#handleDelete"/>

            </HBox>

        </VBox>

    </top>


    <center>

        <TableView fx:id="loansTable"
                   onMouseClicked="#handleTableClick">

            <columns>

                <TableColumn fx:id="idColumn"
                             text="ID"
                             prefWidth="60.0"/>

                <TableColumn fx:id="bookColumn"
                             text="Livro"
                             prefWidth="180.0"/>

                <TableColumn fx:id="userColumn"
                             text="Usuário"
                             prefWidth="180.0"/>

                <TableColumn fx:id="loanDateColumn"
                             text="Data do Empréstimo"
                             prefWidth="150.0"/>

                <TableColumn fx:id="expectedReturnColumn"
                             text="Data Prevista"
                             prefWidth="150.0"/>

                <TableColumn fx:id="returnDateColumn"
                             text="Data de Devolução"
                             prefWidth="150.0"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="100.0"/>

            </columns>

        </TableView>

    </center>

</BorderPane>