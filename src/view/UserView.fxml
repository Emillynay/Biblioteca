<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="view.UserController"
            stylesheets="@style.css">

    <top>
        <Label text="Gerenciar Usuários"
               styleClass="book-title"
               BorderPane.alignment="CENTER">
            <BorderPane.margin>
                <Insets top="25" bottom="25"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox spacing="15" alignment="CENTER">

            <TextField fx:id="nameField"
                       promptText="Nome"
                       maxWidth="500"/>

            <TextField fx:id="numberField"
                       promptText="Número"
                       maxWidth="500"/>

            <TextField fx:id="emailField"
                       promptText="E-mail"
                       maxWidth="500"/>

            <TextField fx:id="addressField"
                       promptText="Endereço"
                       maxWidth="500"/>

            <HBox spacing="10" alignment="CENTER">

                <Button text="Cadastrar"
                        fx:id="saveButton"
                        onAction="#handleSave"/>

                <Button text="Atualizar"
                        fx:id="updateButton"
                        onAction="#handleUpdate"/>

                <Button text="Remover"
                        fx:id="deleteButton"
                        onAction="#handleDelete"/>

            </HBox>

            <TableView fx:id="usersTable"
                       prefHeight="300"
                       prefWidth="800"
                       onMouseClicked="#handleTableClick">

                <columns>

                    <TableColumn fx:id="idColumn"
                                 text="ID"
                                 prefWidth="60"/>

                    <TableColumn fx:id="nameColumn"
                                 text="Nome"
                                 prefWidth="180"/>

                    <TableColumn fx:id="numberColumn"
                                 text="Número"
                                 prefWidth="120"/>

                    <TableColumn fx:id="emailColumn"
                                 text="E-mail"
                                 prefWidth="200"/>

                    <TableColumn fx:id="addressColumn"
                                 text="Endereço"
                                 prefWidth="200"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>